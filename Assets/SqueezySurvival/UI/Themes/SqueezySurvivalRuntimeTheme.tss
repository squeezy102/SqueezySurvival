@import url("unity-theme://default");

/*
 * Text never leaves its container (Docs/Design/UI/ScreenLayout.md, Text containment). Every label and button in
 * every screen wraps its text inside its own width, and grows taller to fit it. Elements that hold text are never
 * given a fixed height, only a minimum, so wrapping can make them taller.
 */
.unity-text-element {
    white-space: normal;
}

/*
 * Two fonts (Docs/Design/ArtDirection.md, Font): Jersey 15 for all text, inherited from the panel root, and
 * Press Start 2P for display text: buttons, titles, headings and the time.
 */
:root {
    -unity-font-definition: url("../../Art/Fonts/Jersey15-Regular.ttf");
}

.unity-button,
.display-text {
    -unity-font-definition: url("../../Art/Fonts/PressStart2P-Regular.ttf");
}
