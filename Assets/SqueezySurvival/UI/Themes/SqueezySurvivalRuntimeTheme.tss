@import url("unity-theme://default");

/*
 * Text never leaves its container (Docs/Design/UI/ScreenLayout.md, Text containment). Every label and button in
 * every screen wraps its text inside its own width, and grows taller to fit it. Elements that hold text are never
 * given a fixed height, only a minimum, so wrapping can make them taller.
 */
.unity-text-element {
    white-space: normal;
}
