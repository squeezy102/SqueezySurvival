<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Template name="GridPanelLayoutOptionsEditor" src="GridPanelLayoutOptionsEditor.uxml" />
    <Style src="Options.uss" />
    <ui:VisualElement name="options-screen-overlay" class="options-overlay">
        <ui:VisualElement class="options-window">
            <ui:Label text="Options" class="options-heading" />
            <ui:ScrollView class="options-sections">
                <ui:Label text="Panels" class="options-section-heading" />
                <ui:Label text="Zone features" class="options-subsection-heading" />
                <ui:Instance template="GridPanelLayoutOptionsEditor" name="zone-features-layout-editor" />
                <ui:Label text="On the ground" class="options-subsection-heading" />
                <ui:Instance template="GridPanelLayoutOptionsEditor" name="ground-pool-layout-editor" />
            </ui:ScrollView>
            <ui:Button name="options-back-button" text="Back" class="options-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
