.options-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.6);
}

.options-window {
    width: 720px;
    max-height: 90%;
    padding-top: 24px;
    padding-bottom: 24px;
    padding-left: 32px;
    padding-right: 32px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    background-color: rgb(30, 40, 52);
}

.options-heading {
    margin-bottom: 16px;
    font-size: 36px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.options-scope-note {
    margin-bottom: 12px;
    font-size: 18px;
    white-space: normal;
    color: rgb(210, 210, 210);
}

.options-sections {
    flex-shrink: 1;
}

.options-section-heading {
    margin-top: 8px;
    margin-bottom: 8px;
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(255, 214, 120);
}

.options-subsection-heading {
    margin-top: 12px;
    margin-bottom: 4px;
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(240, 240, 240);
}

.grid-layout-editor {
    padding-left: 16px;
}

.options-setting-row {
    min-height: 40px;
    margin-left: 0;
    margin-right: 0;
    font-size: 22px;
    color: rgb(240, 240, 240);
}

.options-setting-row > .unity-base-field__label,
.options-setting-row:hover > .unity-base-field__label,
.options-setting-row:focus > .unity-base-field__label,
.options-setting-row:checked > .unity-base-field__label {
    min-width: 260px;
    font-size: 22px;
    color: rgb(240, 240, 240);
}

.options-stepper-row {
    flex-direction: row;
    align-items: center;
}

.options-setting-label {
    min-width: 260px;
    font-size: 22px;
    color: rgb(240, 240, 240);
}

.options-stepper-button {
    width: 48px;
    height: 40px;
    font-size: 24px;
}

.options-stepper-value {
    width: 48px;
    font-size: 22px;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
}

.settings-menu-buttons {
    margin-top: 8px;
}

.settings-status {
    min-height: 28px;
    margin-top: 6px;
    font-size: 18px;
    -unity-font-style: italic;
    white-space: normal;
    color: rgb(255, 214, 120);
}

.options-button {
    height: 48px;
    margin-top: 16px;
    margin-left: 0;
    margin-right: 0;
    font-size: 22px;
}
