.game-screen-root {
    flex-grow: 1;
    flex-direction: row;
    padding-top: 16px;
    padding-bottom: 16px;
    padding-left: 16px;
    padding-right: 16px;
    background-image: url("../../Art/Placeholder/PlaceholderBeachBackground.png");
    -unity-background-scale-mode: scale-and-crop;
}



.hud-clock {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.hud-time-buttons {
    flex-direction: row;
    margin-top: 8px;
    margin-bottom: 8px;
}


.zone-name {
    font-size: 36px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.zone-bar-title {
    flex-direction: row;
    align-items: center;
}

.zone-exploration-progress {
    margin-left: 16px;
    font-size: 22px;
    color: rgb(210, 210, 210);
}

/* The header sits one cell gap (8 px) above the grid, matching the gap between cells. */
.panel-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
}

.panel-header > .panel-heading {
    margin-bottom: 0;
}

.panel-settings-button {
    height: 32px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    font-size: 18px;
}

.grid-panel-grid {
    flex-grow: 1;
    flex-basis: 0;
}

.grid-panel-grid .unity-scroller:disabled {
    opacity: 0.35;
}

.grid-cell {
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: rgba(255, 255, 255, 0.08);
}

.grid-cell-icon {
    position: absolute;
    left: 10%;
    top: 10%;
    right: 10%;
    bottom: 10%;
}

.grid-cell--drag-source {
    opacity: 0.35;
}

.grid-cell--combine-target {
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(255, 214, 120);
    border-right-color: rgb(255, 214, 120);
    border-top-color: rgb(255, 214, 120);
    border-bottom-color: rgb(255, 214, 120);
}

.grid-insertion-marker {
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
    background-color: rgb(255, 214, 120);
}

.grid-dragged-icon {
    opacity: 0.85;
}

.grid-tooltip {
    position: absolute;
    max-width: 360px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 12px;
    padding-right: 12px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(255, 214, 120);
    border-right-color: rgb(255, 214, 120);
    border-top-color: rgb(255, 214, 120);
    border-bottom-color: rgb(255, 214, 120);
    background-color: rgb(20, 28, 38);
}

.grid-tooltip-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(255, 214, 120);
}

.grid-tooltip-description {
    margin-top: 4px;
    margin-bottom: 6px;
    font-size: 18px;
    white-space: normal;
    color: rgb(240, 240, 240);
}

.grid-tooltip-detail {
    font-size: 18px;
    color: rgb(210, 210, 210);
}

.grid-cell-count {
    position: absolute;
    right: 6px;
    bottom: 2px;
    padding: 0;
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: lower-right;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}



.event-log-entries {
    flex-grow: 1;
    flex-basis: 0;
}

.event-log-entry {
    margin-bottom: 4px;
    font-size: 20px;
    color: rgb(240, 240, 240);
    white-space: normal;
}


.panel-heading {
    margin-bottom: 6px;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(255, 214, 120);
}

.placeholder-text {
    font-size: 20px;
    -unity-font-style: italic;
    color: rgb(210, 210, 210);
    white-space: normal;
}

.game-button {
    height: 48px;
    min-width: 200px;
    margin-left: 0;
    margin-right: 0;
    font-size: 22px;
}

.hud-time-buttons > .game-button {
    margin-right: 8px;
}

.pause-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.6);
}

.pause-panel {
    width: 560px;
    padding-top: 28px;
    padding-bottom: 28px;
    padding-left: 28px;
    padding-right: 28px;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    background-color: rgb(30, 40, 52);
}

.pause-heading {
    font-size: 40px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}

.pause-warning {
    margin-top: 8px;
    margin-bottom: 16px;
    font-size: 22px;
    color: rgb(255, 214, 120);
    white-space: normal;
    -unity-text-align: middle-center;
}

.pause-button {
    margin-top: 6px;
    margin-right: 0;
}


.nav-button {
    height: 52px;
    margin-left: 0;
    margin-right: 0;
    margin-bottom: 8px;
    font-size: 20px;
}

/* Layout: every gap between panels and every screen margin is 16px. Growing regions use flex-basis 0, so
   their size comes from the screen, never from their content: panels stay fixed as content grows. */
.gap-right {
    margin-right: 16px;
}

.gap-bottom {
    margin-bottom: 16px;
}

.main-area {
    flex-grow: 1;
    flex-basis: 0;
}

.upper-area {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: row;
}

.left-column {
    width: 480px;
}

.center-column {
    flex-grow: 1;
    flex-basis: 0;
}

.panel {
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 16px;
    padding-right: 16px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    background-color: rgba(18, 30, 42, 0.78);
}

.event-log-panel {
    flex-grow: 1;
    flex-basis: 0;
    overflow: hidden;
}

.zone-bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.zone-features {
    flex-grow: 1;
    flex-basis: 0;
    overflow: hidden;
}

.ground-pool {
    flex-grow: 1;
    flex-basis: 0;
    overflow: hidden;
}

.inventory-panel {
    height: 168px;
}

.nav-bar {
    width: 160px;
}
