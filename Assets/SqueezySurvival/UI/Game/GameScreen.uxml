<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Template name="OptionsScreen" src="../Options/OptionsScreen.uxml" />
    <Style src="GameScreen.uss" />
    <ui:VisualElement name="game-screen-root" class="game-screen-root">
        <ui:VisualElement class="main-area gap-right">
            <ui:VisualElement class="upper-area gap-bottom">
                <ui:VisualElement class="left-column gap-right">
                    <ui:VisualElement class="panel hud-panel gap-bottom">
                        <ui:Label name="hud-clock" class="hud-clock" />
                        <ui:VisualElement class="hud-time-buttons">
                            <ui:Button name="wait-button" class="game-button" />
                            <ui:Button name="rest-button" class="game-button" />
                        </ui:VisualElement>
                        <ui:Label text="Survival stats, temperature and weather: not built yet" class="placeholder-text" />
                    </ui:VisualElement>
                    <ui:VisualElement class="panel event-log-panel">
                        <ui:Label text="Event log" class="panel-heading" />
                        <ui:ScrollView name="event-log-entries" class="event-log-entries" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="center-column">
                    <ui:VisualElement class="panel zone-bar gap-bottom">
                        <ui:VisualElement class="zone-bar-title">
                            <ui:Label name="zone-name" class="zone-name" />
                            <ui:Label name="zone-exploration-progress" class="zone-exploration-progress" />
                        </ui:VisualElement>
                        <ui:Button name="explore-button" class="game-button" />
                    </ui:VisualElement>
                    <ui:VisualElement name="zone-features-panel" class="panel zone-features gap-bottom">
                        <ui:VisualElement class="panel-header">
                            <ui:Label text="Zone features" class="panel-heading" />
                        </ui:VisualElement>
                        <ui:VisualElement name="zone-features-grid" class="inventory-grid" />
                    </ui:VisualElement>
                    <ui:VisualElement name="ground-pool-panel" class="panel ground-pool">
                        <ui:VisualElement class="panel-header">
                            <ui:Label text="On the ground" class="panel-heading" />
                            <ui:Label name="ground-discard-hint" class="ground-discard-hint" />
                            <ui:VisualElement class="sort-controls">
                                <ui:Button name="ground-pool-sort-button" class="sort-button" />
                                <ui:Button name="ground-pool-sort-menu-button" class="sort-menu-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="ground-pool-grid" class="inventory-grid" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="panel inventory-panel">
                <ui:VisualElement class="panel-header">
                    <ui:Label text="Inventory" class="panel-heading" />
                    <ui:VisualElement class="sort-controls">
                        <ui:Button name="inventory-sort-button" class="sort-button" />
                        <ui:Button name="inventory-sort-menu-button" class="sort-menu-button" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="inventory-row">
                    <ui:VisualElement name="hands-grid" class="inventory-grid hands-grid" />
                    <ui:VisualElement class="hands-divider" />
                    <ui:VisualElement name="inventory-grid" class="inventory-grid" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="nav-bar" class="panel nav-bar">
            <ui:Button name="nav-inventory-button" text="Inventory" class="nav-button" />
            <ui:Button name="nav-map-button" text="Map" class="nav-button" />
            <ui:Button name="nav-crafting-button" text="Crafting" class="nav-button" />
            <ui:Button name="nav-skills-button" text="Skills" class="nav-button" />
            <ui:Button name="nav-research-button" text="Research" class="nav-button" />
            <ui:Button name="nav-equipment-button" text="Equipment" class="nav-button" />
            <ui:Button name="nav-cooking-button" text="Cooking" class="nav-button" />
            <ui:Button name="nav-options-button" text="Options" class="nav-button" />
        </ui:VisualElement>
        <ui:VisualElement name="not-built-notice" class="pause-overlay">
            <ui:VisualElement class="pause-panel">
                <ui:Label name="not-built-notice-text" class="pause-warning" />
                <ui:Button name="not-built-notice-close-button" text="Close" class="game-button pause-button" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="ground-overflow-prompt" class="pause-overlay">
            <ui:VisualElement class="pause-panel">
                <ui:Label name="ground-overflow-question" class="pause-warning ground-overflow-question" />
                <ui:Button name="ground-overflow-leave-button" class="game-button pause-button" />
                <ui:Label name="ground-overflow-leave-warning" class="pause-warning" />
                <ui:Button name="ground-overflow-discard-button" text="Choose something to discard" class="game-button pause-button" />
                <ui:Label name="ground-overflow-discard-warning" class="pause-warning" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="pause-menu" class="pause-overlay">
            <ui:VisualElement class="pause-panel">
                <ui:Label text="Paused" class="pause-heading" />
                <ui:Label text="Saving isn't built yet: this run won't be kept." class="pause-warning" />
                <ui:Button name="pause-options-button" text="Options" class="game-button pause-button" />
                <ui:Button name="save-and-exit-button" text="Save and exit" class="game-button pause-button" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="grid-tooltip" class="grid-tooltip">
            <ui:Label name="grid-tooltip-title" class="grid-tooltip-title" />
            <ui:Label name="grid-tooltip-subtitle" class="grid-tooltip-subtitle" />
            <ui:Label name="grid-tooltip-description" class="grid-tooltip-description" />
            <ui:VisualElement name="grid-tooltip-details" />
        </ui:VisualElement>
        <ui:Instance template="OptionsScreen" name="options-screen" />
    </ui:VisualElement>
</ui:UXML>
