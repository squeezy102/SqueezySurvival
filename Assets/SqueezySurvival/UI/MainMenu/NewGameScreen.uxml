<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="new-game-panel" class="menu-options new-game-panel">
        <ui:Label text="New Game" class="screen-heading" />
        <ui:RadioButtonGroup name="dominant-hand-choice" label="Dominant hand" choices="Left,Right" value="-1" class="setting-row" />
        <ui:Label text="Run options (optional)" class="setting-heading" />
        <ui:Label text="Leave these unticked to play the game in its default, intended mode." class="setting-hint" />
        <ui:VisualElement class="option-table-row option-table-header">
            <ui:Label text="Option" class="option-table-name option-table-heading" />
            <ui:Label text="Effect on play" class="option-table-gameplay option-table-heading" />
            <ui:Label text="Points" class="option-table-effect option-table-heading" />
        </ui:VisualElement>
        <ui:VisualElement class="option-table-row">
            <ui:Toggle name="casual-mode-toggle" label="Casual mode" class="setting-row option-table-name" />
            <ui:Label name="casual-mode-gameplay" class="option-table-gameplay" />
            <ui:Label name="casual-mode-effect" class="option-table-effect" />
        </ui:VisualElement>
        <ui:VisualElement class="option-table-row">
            <ui:Toggle name="easy-mode-toggle" label="Easy mode" class="setting-row option-table-name" />
            <ui:Label name="easy-mode-gameplay" class="option-table-gameplay" />
            <ui:Label name="easy-mode-effect" class="option-table-effect" />
        </ui:VisualElement>
        <ui:VisualElement class="option-table-row">
            <ui:Toggle name="hard-mode-toggle" label="Hard mode" class="setting-row option-table-name" />
            <ui:Label name="hard-mode-gameplay" class="option-table-gameplay" />
            <ui:Label name="hard-mode-effect" class="option-table-effect" />
        </ui:VisualElement>
        <ui:Label text="This run earns" class="setting-heading" />
        <ui:Label name="run-points-summary" class="run-points-summary" />
        <ui:VisualElement class="screen-buttons">
            <ui:Button name="new-game-back-button" text="Back" class="menu-button screen-button" />
            <ui:Button name="new-game-start-button" text="Start" class="menu-button screen-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
