.main-menu-root {
    flex-grow: 1;
    padding-top: 64px;
    padding-left: 96px;
    background-image: url("../../Art/Placeholder/PlaceholderBeachBackground.png");
    -unity-background-scale-mode: scale-and-crop;
}

.game-title {
    font-size: 96px;
    -unity-font-style: bold;
    color: rgb(18, 42, 66);
    margin-bottom: 40px;
}

.menu-options {
    width: 440px;
    padding-top: 20px;
    padding-bottom: 20px;
    padding-left: 24px;
    padding-right: 24px;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    background-color: rgba(18, 30, 42, 0.72);
}

.menu-button {
    height: 64px;
    margin-top: 6px;
    margin-bottom: 6px;
    padding-left: 20px;
    font-size: 32px;
    -unity-text-align: middle-left;
}

.version-label {
    position: absolute;
    right: 24px;
    bottom: 16px;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 10px;
    padding-right: 10px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    font-size: 22px;
    color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0.5);
}

.notice-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.6);
}

.notice-panel {
    min-width: 480px;
    padding-top: 32px;
    padding-bottom: 32px;
    padding-left: 32px;
    padding-right: 32px;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    background-color: rgb(30, 40, 52);
}

.notice-text {
    margin-bottom: 24px;
    font-size: 32px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}
