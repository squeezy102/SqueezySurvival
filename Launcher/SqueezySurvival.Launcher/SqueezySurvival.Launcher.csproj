<Project Sdk="Microsoft.NET.Sdk">
  <!-- Avalonia desktop application and Velopack integration. This is Velopack's main executable. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>SqueezySurvivalLauncher</AssemblyName>
    <RootNamespace>SqueezySurvival.Launcher</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SqueezySurvival.Launcher.Core\SqueezySurvival.Launcher.Core.csproj" />
  </ItemGroup>
</Project>
